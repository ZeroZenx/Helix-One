<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.helixone.frontend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>__ROOT__/launchd/run-frontend.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__/frontend</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/logs/frontend.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/frontend.launchd.err.log</string>
</dict>
</plist>
